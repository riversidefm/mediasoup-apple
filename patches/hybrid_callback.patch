+	void SendTransport::setProducerLifecycleCallback(std::function<void(MediaLifecycleEvent, const Producer*)> callback)
+	{
+		// Report the Producers created before the first callback was set.
+		const bool replay               = !this->producerLifecycleCallback;
+		this->producerLifecycleCallback = std::move(callback);
+
+		if (replay && this->producerLifecycleCallback)
+		{
+			// The callback may close Producers or reset itself: replay ids against a copy of it.
+			const auto replayCallback = this->producerLifecycleCallback;
